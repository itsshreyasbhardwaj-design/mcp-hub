# ---------------------------------------------------------------------------
# MCP Hub environment
#
# Every variable below is OPTIONAL. With an empty .env.local, MCP Hub runs
# fully locally: embedded PostgreSQL (PGlite), the dev auth provider, the
# database-backed job queue and the evidence-only assistant. Fill these in to
# move each subsystem onto managed infrastructure.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Postgres connection string. When unset, MCP Hub boots an embedded PostgreSQL
# (PGlite, WASM) under MCP_HUB_DATA_DIR. Supabase: use the pooled connection
# string here and the direct one in DIRECT_URL.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mcp_hub
# Direct (non-pooled) connection, used for migrations only.
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/mcp_hub

# Where the embedded database and other local state live.
MCP_HUB_DATA_DIR=.mcp-hub

# --- Authentication -------------------------------------------------------
# "dev"   - local cookie sessions against seeded users (default, local only)
# "clerk" - Clerk-hosted auth; requires the two keys below
MCP_HUB_AUTH_PROVIDER=dev
# CLERK_SECRET_KEY=sk_test_xxx
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# --- Security -------------------------------------------------------------
# 32-byte key, base64 encoded, used to encrypt stored server credentials.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# When unset a key is generated into MCP_HUB_DATA_DIR/encryption.key (dev only).
# MCP_HUB_ENCRYPTION_KEY=

# Allow registering servers launched as local subprocesses (stdio transport).
# MUST stay false on any multi-tenant deployment: it is arbitrary code execution.
MCP_HUB_ALLOW_STDIO=false
# Comma-separated allowlist of executables usable by stdio servers.
MCP_HUB_STDIO_ALLOWED_COMMANDS=node,npx,python3,uvx,deno,bun

# Allow outbound MCP connections to private/loopback IP ranges. Off by default
# (SSRF protection). Enable only for local development against localhost servers.
MCP_HUB_ALLOW_PRIVATE_NETWORK=false

# --- Jobs -----------------------------------------------------------------
# "database" - durable queue in Postgres, polled by apps/worker (default)
# "redis"    - reserved; see docs/self-hosting.md
MCP_HUB_QUEUE_DRIVER=database
# REDIS_URL=redis://localhost:6379
# TRIGGER_SECRET_KEY=

# --- AI assistant (optional) ----------------------------------------------
# "grounded"   - deterministic, no network, renders collected evidence (default)
# "openrouter" - routes explanations through OpenRouter; requires the key below
MCP_HUB_LLM_PROVIDER=grounded
# OPENROUTER_API_KEY=
# MCP_HUB_LLM_MODEL=anthropic/claude-sonnet-5

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
