{
  "name": "@mcp-hub/mcp-server",
  "version": "0.1.0",
  "description": "MCP Hub exposed as an MCP server, so agents can query the registry through MCP",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint src",
    "typecheck": "tsc -b --noEmit false",
    "test": "vitest run --passWithNoTests"
  },
  "bin": {
    "mcp-hub-server": "./dist/bin.js"
  },
  "dependencies": {
    "@mcp-hub/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mcp-hub/api": "workspace:*",
    "@mcp-hub/database": "workspace:*",
    "@mcp-hub/config": "workspace:*",
    "@mcp-hub/core": "workspace:*",
    "@mcp-hub/security": "workspace:*",
    "@mcp-hub/mcp-client": "workspace:*"
  }
}
