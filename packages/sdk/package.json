{
  "name": "@mcp-hub/sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the MCP Hub API",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint src",
    "typecheck": "tsc -b --noEmit false",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sdk",
    "mcp-hub"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/itsshreyasbhardwaj-design/mcp-hub.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  }
}
