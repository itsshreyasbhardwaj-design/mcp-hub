{
  "name": "@mcp-hub/api",
  "version": "0.1.0",
  "description": "Application services and a framework-agnostic REST API for MCP Hub",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint src",
    "typecheck": "tsc -b --noEmit false",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mcp-hub/core": "workspace:*",
    "@mcp-hub/config": "workspace:*",
    "@mcp-hub/observability": "workspace:*",
    "@mcp-hub/database": "workspace:*",
    "@mcp-hub/security": "workspace:*",
    "@mcp-hub/mcp-client": "workspace:*",
    "@mcp-hub/validator": "workspace:*",
    "@mcp-hub/versioning": "workspace:*",
    "@mcp-hub/permissions": "workspace:*",
    "@mcp-hub/testing": "workspace:*",
    "@mcp-hub/search": "workspace:*",
    "@mcp-hub/analytics": "workspace:*",
    "@mcp-hub/assistant": "workspace:*",
    "zod": "^4.6.5"
  }
}
