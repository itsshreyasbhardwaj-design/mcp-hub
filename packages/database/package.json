{
  "name": "@mcp-hub/database",
  "version": "0.1.0",
  "description": "PostgreSQL schema, migrations, drivers and repositories",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint src",
    "typecheck": "tsc -b --noEmit false",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  },
  "dependencies": {
    "@mcp-hub/core": "workspace:*",
    "@mcp-hub/config": "workspace:*",
    "@mcp-hub/observability": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "pg": "^8.23.0"
  }
}
