{
  "name": "@mcp-hub/ui",
  "version": "0.1.0",
  "description": "Presentational React components and design tokens shared by the MCP Hub dashboard",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint src",
    "typecheck": "tsc -b --noEmit false",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "lucide-react": "^1.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "lucide-react": "^1.48.0"
  },
  "dependencies": {
    "@mcp-hub/core": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  }
}
