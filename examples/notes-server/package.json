{
  "name": "@mcp-hub/example-notes-server",
  "version": "0.1.0",
  "private": true,
  "description": "A small but complete MCP server used to exercise MCP Hub end to end",
  "license": "MIT",
  "type": "module",
  "bin": { "notes-server": "./dist/index.js" },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc -b --noEmit false",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  }
}
