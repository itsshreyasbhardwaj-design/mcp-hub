{
  "name": "@mcp-hub/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background worker: health monitoring, indexing, validation and housekeeping",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mcp-hub-worker": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint src",
    "typecheck": "tsc -b --noEmit false",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mcp-hub/analytics": "workspace:*",
    "@mcp-hub/api": "workspace:*",
    "@mcp-hub/config": "workspace:*",
    "@mcp-hub/core": "workspace:*",
    "@mcp-hub/database": "workspace:*",
    "@mcp-hub/observability": "workspace:*"
  }
}
